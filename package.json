{
  "name": "@diegolopez02081/anime-local",
  "version": "0.4.2",
  "description": "Anime and manga library for web and Windows, with favorites, ratings and direct playback.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "anime-local": "bin/anime-local.mjs"
  },
  "scripts": {
    "start": "node bin/anime-local.mjs",
    "web": "node local-server.mjs",
    "test": "node --test",
    "smoke": "node smoke.mjs",
    "prepublishOnly": "npm test",
    "desktop": "electron .",
    "desktop:smoke": "electron . --smoke",
    "desktop:build": "electron-builder --win nsis zip --x64 --publish never"
  },
  "files": [
    "bin/",
    "api/",
    "lib.mjs",
    "catalog.mjs",
    "profiles.mjs",
    "player.mjs",
    "local-server.mjs",
    "cli.mjs",
    "catalog.html",
    "web.html",
    "vercel.json",
    "LICENSE",
    "README.md",
    "ROADMAP.md",
    "sources.mjs",
    "manga.mjs",
    "manga-ui.mjs",
    "ratings.mjs",
    "ratings-ui.mjs",
    "previews.mjs",
    "reader-cache.mjs",
    "experience.mjs",
    "desktop/",
    "pwa-ui.mjs",
    "pwa-assets.mjs",
    "public/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiegoLopez0208/anime-local.git"
  },
  "bugs": {
    "url": "https://github.com/DiegoLopez0208/anime-local/issues"
  },
  "homepage": "https://github.com/DiegoLopez0208/anime-local#readme",
  "keywords": [
    "anime",
    "catalog",
    "vlc",
    "mega",
    "watchlist"
  ],
  "dependencies": {
    "cheerio": "^1.2.0",
    "megajs": "^1.3.10"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "main": "desktop/main.cjs",
  "author": "Diego Lopez",
  "build": {
    "appId": "com.diegolopez.animelocal",
    "productName": "Anime Local",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop/**",
      "*.mjs",
      "catalog.html",
      "web.html",
      "LICENSE",
      "package.json",
      "!*.test.mjs",
      "!cloud-dev.mjs",
      "!smoke.mjs",
      "public/**"
    ],
    "asar": true,
    "win": {
      "icon": "desktop/icon.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "Anime-Local-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Anime-Local-Windows-Setup.${ext}"
    },
    "publish": null
  }
}
