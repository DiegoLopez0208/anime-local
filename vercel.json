{
  "version": 2,
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "{catalog.html,web.html,profiles.mjs,manga-ui.mjs}"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index?route=home"
    },
    {
      "source": "/reproductor",
      "destination": "/api/index?route=manual"
    },
    {
      "source": "/profiles.mjs",
      "destination": "/api/index?route=profiles"
    },
    {
      "source": "/manga-ui.mjs",
      "destination": "/api/index?route=manga-ui"
    },
    {
      "source": "/manga-cover/:id/:file",
      "destination": "/api/index?route=manga-cover&id=:id&file=:file"
    },
    {
      "source": "/manga-page/:id/:page",
      "destination": "/api/index?route=manga-image&id=:id&page=:page"
    },
    {
      "source": "/image/:path*",
      "destination": "/api/index?route=image&path=:path*"
    },
    {
      "source": "/video/:id",
      "destination": "/api/index?route=video&id=:id"
    },
    {
      "source": "/api/:action*",
      "destination": "/api/index?route=api&action=:action*"
    }
  ],
  "framework": null
}
